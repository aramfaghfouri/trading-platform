# Environment Variables for Trading Platform
# Copy this file to .env and fill in your actual values

# Database Configuration
# Make TimescaleDB connection dynamic via host/port vars
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=6432
DATABASE_URL=postgresql://trading_user:trading_password@${TIMESCALEDB_HOST}:${TIMESCALEDB_PORT}/trading_platform

# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here

# Interactive Brokers Configuration
IBKR_ACCOUNT_ID=your_ibkr_account_id_here
IBKR_PAPER_TRADING=true
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Trading Configuration
TRADING_ENVIRONMENT=development
TRADING_TIMEZONE=America/New_York

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/trading_platform.log

# Security Configuration
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Redis Configuration (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Development Configuration
DEBUG=true
HOT_RELOAD=true
TESTING=false

# Production Configuration
# DEBUG=false
# HOT_RELOAD=false
# TESTING=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# WebSocket Configuration
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8001

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIRECTORY=uploads

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Slack Configuration (for alerts)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#trading-alerts

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION=30

# Performance Configuration
MAX_MEMORY_USAGE=0.80
GARBAGE_COLLECTION_INTERVAL=3600
CACHE_TTL=300

# Risk Management Configuration
MAX_POSITION_SIZE=0.10
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15
MAX_CORRELATION=0.70

# Data Quality Configuration
MIN_VOLUME_THRESHOLD=1000
MAX_PRICE_DEVIATION=0.1
OUTLIER_DETECTION=true
MISSING_DATA_HANDLING=interpolate

# Strategy Configuration
MAX_CONCURRENT_STRATEGIES=10
STRATEGY_TIMEOUT=300
ENABLE_PARALLEL_EXECUTION=true

# Order Management Configuration
MAX_ORDER_SIZE=10000
MIN_ORDER_SIZE=1
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1
EXECUTION_TIMEOUT=30

# Market Data Configuration
DATA_LATENCY_THRESHOLD=5
API_LIMIT_USAGE_THRESHOLD=80
DATA_VALIDATION=true

# Portfolio Management Configuration
POSITION_UPDATE_INTERVAL=1
PNL_UPDATE_INTERVAL=5
SYNC_WITH_DATABASE=true

# System Monitoring Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
CPU_USAGE_THRESHOLD=80
MEMORY_USAGE_THRESHOLD=80
DISK_USAGE_THRESHOLD=90

# Audit Configuration
AUDIT_LOGGING=true
AUDIT_RETENTION=365
AUDIT_ENCRYPTION=true

# Compliance Configuration
COMPLIANCE_ENABLED=false
COMPLIANCE_REPORTING=true
COMPLIANCE_RETENTION=2555  # 7 years

# Feature Flags
FEATURE_LIVE_TRADING=false
FEATURE_REAL_TIME_DATA=false
FEATURE_ML_INTEGRATION=false
FEATURE_WEB_DASHBOARD=false
FEATURE_ADVANCED_ANALYTICS=false

# External API Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
YAHOO_FINANCE_ENABLED=true
QUANDL_API_KEY=your_quandl_api_key_here

# Machine Learning Configuration
ML_MODEL_PATH=models/
ML_CACHE_SIZE=1000
ML_PREDICTION_INTERVAL=60

# Notification Configuration
NOTIFICATION_ENABLED=true
NOTIFICATION_EMAIL=true
NOTIFICATION_SLACK=true
NOTIFICATION_SMS=false

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance
MAINTENANCE_START_TIME=
MAINTENANCE_END_TIME=