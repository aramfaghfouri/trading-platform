# Polygon.io API Configuration
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_BASE_URL=https://api.polygon.io
POLYGON_RATE_LIMIT_DELAY=0.1
POLYGON_MAX_RETRIES=3
POLYGON_TIMEOUT=30

# Data Collection Settings
POLYGON_DAYS_BACK=30
POLYGON_MAX_TICKERS=100

# Storage Settings
POLYGON_DATA_PATH=./data/polygon
POLYGON_CSV_EXPORT=true
POLYGON_JSON_EXPORT=true

# Processing Settings
POLYGON_TECH_ANALYSIS=true
POLYGON_SENTIMENT_ANALYSIS=true